{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "plutotheory.com"
        }
      ],
      "destination": "https://www.plutotheory.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pluto-theory.vercel.app"
        }
      ],
      "destination": "https://www.plutotheory.com/$1",
      "permanent": true
    },
    {
      "source": "/what-we-are",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ai-automation",
      "destination": "/automations",
      "permanent": true
    },
    {
      "source": "/ai-agents",
      "destination": "/automations/lead-generation",
      "permanent": true
    },
    {
      "source": "/branding",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/photography",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/ai-photoshoot",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/studio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; font-src 'self'; media-src 'self'; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
